# --- App ---
ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# --- Login single-user ---
# Email dell'unico account scout. La password si imposta come hash bcrypt:
# generalo con lo script backend/scripts/hash_password.py
AUTH_EMAIL=scout@wikiscout.it
AUTH_PASSWORD_HASH=

# --- Database ---
DATABASE_URL=postgresql+psycopg2://wikiscout:wikiscout@localhost:5432/wikiscout

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=1800

# --- CORS (URL del frontend Netlify, separati da virgola se piu' di uno) ---
CORS_ORIGINS=http://localhost:5173

# --- Scheduler job notturno (orario UTC) ---
ENABLE_SCHEDULER=true
NIGHTLY_JOB_HOUR=3
NIGHTLY_JOB_MINUTE=0

# --- Fase B: chiavi API esterne (lascia vuoto finche' non le hai) ---
# Registrati su https://www.api-football.com/ (piano gratuito RapidAPI o diretto)
API_FOOTBALL_KEY=
API_FOOTBALL_DAILY_LIMIT=100

# Registrati su https://apify.com/ per gli actor di scraping Understat/Transfermarkt/Sofascore
APIFY_TOKEN=
