# --- App ---
ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# --- Login single-user ---
# Email dell'unico account scout. La password si imposta come hash bcrypt:
# generalo con lo script backend/scripts/hash_password.py
AUTH_EMAIL=scout@wikiscout.it
AUTH_PASSWORD_HASH=

# --- Database ---
DATABASE_URL=postgresql+psycopg2://wikiscout:wikiscout@localhost:5432/wikiscout

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=1800

# --- CORS (URL del frontend Netlify, separati da virgola se piu' di uno) ---
CORS_ORIGINS=http://localhost:5173

# --- Scheduler job notturno (orario UTC) ---
ENABLE_SCHEDULER=true
NIGHTLY_JOB_HOUR=3
NIGHTLY_JOB_MINUTE=0

# --- Apify (usato solo per il valore di mercato Transfermarkt) ---
# Registrati su https://apify.com/ per ottenere il token
APIFY_TOKEN=

# --- Sofascore (scraping via Playwright: nessuna chiave necessaria) ---
# Pausa minima (secondi) tra una richiesta e l'altra, per non sovraccaricare
# il sito e ridurre il rischio di blocchi IP.
SOFASCORE_REQUEST_DELAY_SECONDS=1.5

# --- API-Football: LEGACY/OPZIONALE, spenta di default ---
# Ricerca e statistiche di base ora vengono da Transfermarkt/Sofascore.
# Questa fonte resta disponibile ma va accesa esplicitamente se in futuro
# serve per dati che le altre due non coprono (es. formazioni).
ENABLE_API_FOOTBALL=false
API_FOOTBALL_KEY=
API_FOOTBALL_DAILY_LIMIT=100
